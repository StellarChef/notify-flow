# Configuration template. Copy to .env and fill in the values:
#   cp .env.example .env
# The real .env is gitignored and never reaches the repo.

# --- Database ------------------------------------------------------------
# DB_HOST/DB_PORT are read by docker-compose when starting the Postgres container.
DB_HOST=localhost
DB_PORT=5436
DB_NAME=notify_flow
DB_USER=postgres
DB_PASSWORD=

# The full connection string - THIS is what the app reads (Database/config_db.py).
# Port 5433 because docker-compose maps 5433 -> 5432, so it does not collide
# with a Postgres already running locally on the default port.
DB_URL=postgresql+psycopg2://postgres:password@localhost:5436/notify_flow

# --- Shoper --------------------------------------------------------------
SHOPER_API_KEY=
SHOPER_CLIENT_ID=
SHOP_ADDRESS=https://your-shop.com/webapi/rest

# --- Webhook -------------------------------------------------------------
# Compared against the X-Webhook-Secret header in Api/webhook.py.
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Auth ----------------------------------------------------------------
# Signs the JWTs. Whoever holds it can mint a token for any user, so treat it
# like a password. Generate a random one, at least 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=

# --- Logging -------------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR. Defaults to INFO when unset.
LOG_LEVEL=INFO
